<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>WaterWatch Gauteng — UI Preview</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Outfit:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#F6F7F5; --surface:#FFFFFF; --border:#E3E5E0; --text:#1C1F1E; --muted:#6B7268;
    --accent:#0F6E6B; --accent-tint:#E6F2F1;
    --success:#2F7D52; --success-tint:#EAF6EE;
    --warning:#B5700A; --warning-tint:#FDF3E3;
    --danger:#B3261E; --danger-tint:#FBEAEA;
    padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      --bg:#14171A; --surface:#1B1F22; --border:#2A2F33; --text:#F2F3F1; --muted:#9BA2A0;
      --accent-tint:#163432; --success-tint:#15271C; --warning-tint:#2B2013; --danger-tint:#2B1716;
    }
  }
  :root[data-theme="dark"]{
    --bg:#14171A; --surface:#1B1F22; --border:#2A2F33; --text:#F2F3F1; --muted:#9BA2A0;
    --accent-tint:#163432; --success-tint:#15271C; --warning-tint:#2B2013; --danger-tint:#2B1716;
  }
  *{box-sizing:border-box;}
  html{scroll-padding-top:env(safe-area-inset-top,0px);}
  html,body{height:100%;}
  body{margin:0; background:var(--bg); color:var(--text); font-family:'Plus Jakarta Sans',system-ui,sans-serif; -webkit-font-smoothing:antialiased;}
  h1,h2,h3{font-family:'Outfit','Plus Jakarta Sans',sans-serif; margin:0;}
  .mono{font-family:'JetBrains Mono',monospace;}
  a{color:inherit; cursor:pointer;}
  svg{display:block;}
  .icon{width:16px; height:16px; stroke:currentColor; fill:none; stroke-width:1.75; stroke-linecap:round; stroke-linejoin:round; flex-shrink:0;}
  button{font-family:inherit; cursor:pointer;}

  .banner{
    background:var(--danger-tint); color:var(--danger); border-bottom:1px solid var(--border);
    padding:8px 20px; display:flex; align-items:center; gap:8px; font-size:12.5px; font-weight:600;
  }
  .banner .icon{width:14px;height:14px;}
  .banner a{margin-left:auto; font-weight:700; text-decoration:underline; white-space:nowrap; background:none; border:none; color:inherit; font-size:inherit; padding:0;}

  header.app{
    display:flex; align-items:center; gap:12px; padding:12px 20px; background:var(--surface);
    border-bottom:1px solid var(--border); position:sticky; top:0; z-index:20;
  }
  .logo{display:flex; align-items:center; gap:8px; font-weight:700; font-size:15px; background:none; border:none; color:var(--text); padding:0;}
  .logo .mark{width:26px;height:26px;border-radius:6px;background:var(--accent);display:flex;align-items:center;justify-content:center;color:#fff;}
  .logo .mark .icon{width:14px;height:14px;stroke:#fff;}
  .area-pill{display:flex; align-items:center; gap:5px; font-size:12px; font-weight:600; color:var(--muted);
    background:var(--bg); border:1px solid var(--border); padding:5px 10px; border-radius:6px; margin-left:4px;}
  .header-actions{margin-left:auto; display:flex; align-items:center; gap:8px; position:relative;}
  .icon-btn{width:32px;height:32px;border-radius:6px;border:1px solid var(--border); background:var(--surface);
    display:flex;align-items:center;justify-content:center; position:relative; color:var(--muted);}
  .icon-btn .dot{position:absolute; top:5px; right:6px; width:5px;height:5px;border-radius:50%;background:var(--danger);}
  .btn-primary{background:var(--accent); color:#fff; font-weight:700; font-size:12.5px; padding:8px 13px;
    border-radius:6px; display:flex; align-items:center; gap:5px; border:none;}
  .btn-primary .icon{width:14px;height:14px;stroke:#fff;}

  .notif-panel{
    position:absolute; top:42px; right:0; width:260px; background:var(--surface); border:1px solid var(--border);
    border-radius:8px; box-shadow:0 8px 24px rgba(0,0,0,.1); padding:6px; display:none; z-index:30;
  }
  .notif-panel.open{display:block;}
  .notif-panel h4{font-size:12px; padding:6px 8px 4px; color:var(--muted); text-transform:uppercase; letter-spacing:.04em;}
  .notif-row{padding:8px; border-radius:6px; font-size:12.5px;}
  .notif-row:hover{background:var(--bg);}
  .notif-row .t{font-weight:700;}
  .notif-row .m{color:var(--muted); font-size:11.5px; margin-top:1px;}

  .layout{display:flex; max-width:1160px; margin:0 auto;}
  .sidebar{width:196px; flex-shrink:0; padding:16px 10px; border-right:1px solid var(--border); min-height:calc(100vh - 78px);}
  .nav-item{display:flex; align-items:center; gap:9px; padding:8px 10px; border-radius:6px; width:100%; text-align:left;
    font-size:13px; font-weight:600; color:var(--muted); margin-bottom:1px; background:none; border:none;}
  .nav-item.active{background:var(--accent-tint); color:var(--accent);}
  .nav-item:not(.active):hover{background:var(--bg);}
  .sidebar-cta{margin-top:12px; border:1px solid var(--border); color:var(--text); text-align:center; padding:8px; width:100%;
    border-radius:6px; font-weight:700; font-size:12.5px; background:var(--surface); display:flex; align-items:center; justify-content:center; gap:6px;}

  main{flex:1; padding:20px 22px 90px; max-width:760px;}
  .view{display:none;}
  .view.active{display:block;}
  .greeting{font-size:18px; font-weight:700;}
  .greeting-sub{color:var(--muted); font-size:13px; margin:2px 0 16px;}

  .status-card{background:var(--surface); border:1px solid var(--border); border-left:3px solid var(--success);
    border-radius:8px; padding:16px; display:flex; justify-content:space-between; align-items:center; margin-bottom:14px;}
  .status-card .label{font-size:11px; color:var(--muted); font-weight:700; text-transform:uppercase; letter-spacing:.04em;}
  .status-card .value{font-size:17px; font-weight:700; margin:3px 0 2px;}
  .status-card .sub{font-size:12px; color:var(--muted);}
  .status-card .pct{font-size:20px; font-weight:800; color:var(--success);}

  .stats-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:10px; margin-bottom:14px;}
  .stat-card{background:var(--surface); border:1px solid var(--border); border-radius:8px; padding:12px;}
  .stat-card .icon{color:var(--muted); margin-bottom:8px;}
  .stat-card .num{font-size:16px; font-weight:800;}
  .stat-card .lbl{font-size:11px; color:var(--muted); font-weight:600; margin-top:1px;}

  .actions-row{display:grid; grid-template-columns:repeat(3,1fr); gap:8px; margin-bottom:16px;}
  .action-btn{background:var(--surface); border:1px solid var(--border); border-radius:8px; padding:10px 8px;
    text-align:center; width:100%;}
  .action-btn .icon{width:18px;height:18px; color:var(--accent); margin:0 auto 6px;}
  .action-btn .t{font-size:11.5px; font-weight:700;}

  .section-card{background:var(--surface); border:1px solid var(--border); border-radius:8px; padding:16px; margin-bottom:14px;}
  .section-head{display:flex; align-items:center; justify-content:space-between; margin-bottom:12px;}
  .section-head h3{font-size:13.5px; font-weight:700;}
  .section-head .link{font-size:12px; color:var(--accent); font-weight:700; background:none; border:none; padding:0;}

  .timeline{display:flex; gap:5px;}
  .tl-item{flex:1; display:flex; flex-direction:column; align-items:center; gap:5px;}
  .tl-bar{width:100%; height:38px; border-radius:4px; background:var(--bg); display:flex; align-items:flex-end; overflow:hidden;}
  .tl-fill{width:100%; border-radius:4px;}
  .tl-time{font-size:9.5px; color:var(--muted); font-weight:600;}

  .report-row{display:flex; gap:10px; align-items:flex-start; padding:8px 0; border-top:1px solid var(--border);}
  .report-row:first-child{border-top:none; padding-top:0;}
  .report-dot{width:7px;height:7px;border-radius:50%; margin-top:5px; flex-shrink:0;}
  .report-title{font-size:13px; font-weight:700;}
  .report-meta{font-size:11.5px; color:var(--muted); margin-top:1px;}

  .placeholder{display:flex; flex-direction:column; align-items:flex-start; gap:10px;}
  .placeholder .icon{width:26px;height:26px; color:var(--accent);}
  .placeholder p{font-size:13px; color:var(--muted); margin:0; line-height:1.5;}

  .bottom-nav{position:fixed; bottom:0; left:0; right:0; background:var(--surface); border-top:1px solid var(--border);
    display:none; justify-content:space-around; align-items:center; padding:6px 4px calc(6px + env(safe-area-inset-bottom,0px)); z-index:20;}
  .bn-item{display:flex; flex-direction:column; align-items:center; gap:2px; font-size:9.5px; font-weight:700; color:var(--muted); padding:4px 8px; background:none; border:none;}
  .bn-item.active{color:var(--accent);}
  .bn-item .icon{width:18px;height:18px;}

  .overlay{position:fixed; inset:0; background:rgba(15,17,16,.4); display:none; align-items:center; justify-content:center; z-index:40; padding:16px;}
  .overlay.open{display:flex;}
  .modal{background:var(--surface); border-radius:10px; width:100%; max-width:380px; padding:18px; border:1px solid var(--border);}
  .modal-head{display:flex; align-items:center; justify-content:space-between; margin-bottom:14px;}
  .modal-head h3{font-size:14.5px; font-weight:700;}
  .modal-close{width:26px;height:26px; border-radius:6px; border:1px solid var(--border); background:var(--surface); display:flex; align-items:center; justify-content:center; color:var(--muted);}
  .field{margin-bottom:12px;}
  .field label{display:block; font-size:11.5px; font-weight:700; color:var(--muted); margin-bottom:5px;}
  .field select, .field textarea{
    width:100%; border:1px solid var(--border); border-radius:6px; padding:8px 9px; font-family:inherit; font-size:13px; background:var(--bg); color:var(--text);
  }
  .field textarea{resize:vertical; min-height:70px;}
  .area-option{display:flex; align-items:center; justify-content:space-between; padding:9px 10px; border-radius:6px; font-size:13px; font-weight:600; border:1px solid var(--border); margin-bottom:6px;}
  .area-option.selected{border-color:var(--accent); background:var(--accent-tint); color:var(--accent);}
  .toast{position:fixed; bottom:20px; left:50%; transform:translateX(-50%); background:var(--text); color:var(--bg);
    padding:10px 16px; border-radius:8px; font-size:12.5px; font-weight:600; z-index:50; display:none;}
  .toast.show{display:block;}

  @media (max-width:860px){ .sidebar{display:none;} main{padding:16px 14px 84px; max-width:100%;} .bottom-nav{display:flex;} }
  @media (max-width:420px){ .stats-grid{gap:7px;} .stat-card{padding:9px;} }
</style>
</head>
<body>

