<script>
  // ---- timeline ----
  const hours = ['06:00','09:00','12:00','15:00','18:00','21:00','00:00','03:00'];
  const levels = [1,1,1,0.5,0,0,0,1];
  const colors = {1:'var(--success)',0.5:'var(--warning)',0:'var(--danger)'};
  const heights = {1:'100%',0.5:'55%',0:'15%'};
  const tl = document.getElementById('timeline');
  hours.forEach((h,i)=>{
    const lvl = levels[i];
    const item = document.createElement('div');
    item.className='tl-item';
    item.innerHTML = `<div class="tl-bar"><div class="tl-fill" style="height:${heights[lvl]}; background:${colors[lvl]};"></div></div><div class="tl-time mono">${h}</div>`;
    tl.appendChild(item);
  });

  // ---- view switching ----
  function setView(view){
    document.querySelectorAll('.view').forEach(v=>v.classList.toggle('active', v.id === 'view-'+view));
    document.querySelectorAll('[data-view]').forEach(el=>{
      if(el.classList.contains('nav-item') || el.classList.contains('bn-item')){
        el.classList.toggle('active', el.dataset.view === view);
      }
    });
    closeNotif(); closeReport(); closeArea();
    window.scrollTo({top:0, behavior:'smooth'});
  }
  document.querySelectorAll('[data-view]').forEach(el=>{
    el.addEventListener('click', ()=> setView(el.dataset.view));
  });

  // ---- notifications dropdown ----
  const notifPanel = document.getElementById('notifPanel');
  const bellBtn = document.getElementById('bellBtn');
  function closeNotif(){ notifPanel.classList.remove('open'); }
  bellBtn.addEventListener('click', (e)=>{ e.stopPropagation(); notifPanel.classList.toggle('open'); });
  document.addEventListener('click', (e)=>{ if(!bellBtn.contains(e.target)) closeNotif(); });

  // ---- report modal ----
  const reportOverlay = document.getElementById('reportOverlay');
  function openReport(){ reportOverlay.classList.add('open'); }
  function closeReport(){ reportOverlay.classList.remove('open'); }
  document.getElementById('reportBtn').addEventListener('click', openReport);
  document.getElementById('sidebarReportBtn').addEventListener('click', openReport);
  document.getElementById('bnReportBtn').addEventListener('click', openReport);
  document.getElementById('closeReport').addEventListener('click', closeReport);
  reportOverlay.addEventListener('click', (e)=>{ if(e.target === reportOverlay) closeReport(); });
  document.getElementById('submitReport').addEventListener('click', ()=>{
    closeReport();
    showToast('Report submitted — thanks for helping your community');
  });

  // ---- area modal ----
  const areas = ['Soweto, Region B','Sandton, Region E','Alexandra, Region E','Midrand, Region A','Randburg, Region C'];
  const areaOverlay = document.getElementById('areaOverlay');
  const areaList = document.getElementById('areaList');
  const areaLabel = document.getElementById('areaLabel');
  function renderAreas(){
    areaList.innerHTML = areas.map(a=>
      `<div class="area-option ${a===areaLabel.textContent?'selected':''}" data-area="${a}">${a}</div>`
    ).join('');
    areaList.querySelectorAll('.area-option').forEach(opt=>{
      opt.addEventListener('click', ()=>{
        areaLabel.textContent = opt.dataset.area;
        closeArea();
        showToast('Area updated to '+opt.dataset.area);
      });
    });
  }
  function openArea(){ renderAreas(); areaOverlay.classList.add('open'); }
  function closeArea(){ areaOverlay.classList.remove('open'); }
  document.getElementById('areaBtn').addEventListener('click', openArea);
  document.getElementById('closeArea').addEventListener('click', closeArea);
  areaOverlay.addEventListener('click', (e)=>{ if(e.target === areaOverlay) closeArea(); });

  // ---- toast ----
  let toastTimer;
  function showToast(msg){
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(()=> t.classList.remove('show'), 2600);
  }
</script>

</body>
</html>
